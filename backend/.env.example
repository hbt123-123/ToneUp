# --- data ---
DATA_ROOT=data

# --- JWT ---
JWT_SECRET=your-256-bit-secret-key-minimum
JWT_EXPIRE_HOURS=12

# --- Zhipu AI ---
ZHIPU_API_KEY=your-zhipu-api-key
GLM_VISION_MODEL=glm-4.6v-flash
GLM_TEXT_MODEL=glm-4.7-flash

# --- Markdown & CORS ---
CLEAN_MARKDOWN=true
CORS_ALLOW_ORIGINS=http://localhost:3000 https://example.com

# --- Retry & Concurrency ---
REVIEW_RETRY_HOURS=4
GRADING_CONCURRENCY=1
TRUSTED_PROXY_COUNT=0

# --- AI sync limits ---
AI_SYNC_MAX_BYTES=1048576
AI_SYNC_MAX_PIXELS=2048

# --- Upload retention ---
UPLOAD_RETENTION_DAYS=

# --- Timezone ---
STATS_TZ=Asia/Shanghai